{
  "name": "ecommerce-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ecommerce-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"]
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "ecommerce-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "ecommerce-api:build:development"
        },
        "production": {
          "buildTarget": "ecommerce-api:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "build-product-embeddings-cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build --config webpack.cli.config.js",
        "cwd": "apps/ecommerce-api"
      }
    },
    "product-embeddings": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-product-embeddings-cli"],
      "options": {
        "command": "node dist/apps/ecommerce-api-cli/main.js {args}",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
