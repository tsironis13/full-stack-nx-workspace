{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "rootDir": ".",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/mastra/agents/shopping-agent.instructions.ts",
    "src/mastra/workflows/cart-item-workflow.contract.ts",
    "src/mastra/workflows/cart-item-workflow.surfaces.ts"
  ]
}
